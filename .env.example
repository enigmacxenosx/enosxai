# Enosx AI orchestration service (copy to .env; never commit real keys)
NVIDIA_API_KEYS=
# Backward-compatible single-key form; comma-separated rotation above is preferred.
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
TAVILY_API_KEY=
# User specification default. For NVIDIA hosted OpenAI-compatible NIM, set the deployed base URL here.
NVIDIA_API_BASE_URL=https://nvidia.com
LOCAL_API_BASE_URL=http://localhost:8000/v1
ENOSX_BRAIN_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT_SECONDS=90
RETRY_ATTEMPTS=3
MEMORY_PATH=./data/enosx_memory
MCP_TRANSPORT=stdio
MCP_PORT=8765
