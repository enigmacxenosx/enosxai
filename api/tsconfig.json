{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2022", "dom"],
    "types": ["node"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "noEmitOnError": false
  },
  "include": ["**/*.ts"]
}
