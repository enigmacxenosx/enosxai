{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ENOSX AI",
  "version": "0.1.8",
  "identifier": "com.enosx.ai",
  "build": {
    "beforeDevCommand": "pnpm --dir ../enosx-app dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --dir ../enosx-app build",
    "frontendDist": "../../enosx-app/dist/public"
  },
  "app": {
    "windows": [
      {
        "title": "ENOSX AI",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "publisher": "Enosx Technologies",
    "copyright": "Copyright \u00a9 2026 Enosx Technologies",
    "shortDescription": "ENOSX AI desktop assistant",
    "homepage": "https://github.com/enigmacxenosx/enosxai",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer-assets/header.bmp",
        "sidebarImage": "installer-assets/sidebar.bmp",
        "installMode": "currentUser",
        "startMenuFolder": "Enosx Technologies",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU4ODJDNTgzQzExNkI0MkEKUldRcXRCYkJnOFdDNkxMS0FJdXNPVDFva3lHN1Fxb3RIOHFhejJ6TGh4RWRUaTc4TjBzZEE4TGMK",
      "endpoints": [
        "https://github.com/enigmacxenosx/enosxai/releases/latest/download/latest.json"
      ]
    }
  }
}
