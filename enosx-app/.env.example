# Public Google OAuth client ID for the browser sign-in flow.
# Add the production origin to the OAuth client's authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=

# Optional Neon auth API base URL. Leave blank to use local fallback auth.
VITE_NEON_API_URL=

# Server-side NVIDIA credentials for ENOSX AI chat and image generation.
# Never expose these keys with a VITE_ prefix.
NVIDIA_API_KEY=
NVIDIA_IMAGE_API_KEY=
# NVIDIA hosted FLUX.1 Kontext-dev endpoint for edits with an attached image.
# Prompt-only generation is routed server-side to hosted FLUX.2 Klein 4B.
NVIDIA_IMAGE_ENDPOINT=https://ai.api.nvidia.com/v1/genai/black-forest-labs/flux.1-kontext-dev
NVIDIA_IMAGE_MODEL=black-forest-labs/flux.1-kontext-dev
PUBLIC_APP_URL=https://enosx.ai
