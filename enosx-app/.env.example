# Public Google OAuth client ID for the browser sign-in flow.
# Add the production origin to the OAuth client's authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=

# Optional Neon auth API base URL. Leave blank to use local fallback auth.
VITE_NEON_API_URL=

# Server-side OpenRouter credentials for ENOSX AI image generation.
# Never expose this key with a VITE_ prefix.
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-4.5
PUBLIC_APP_URL=https://enosx.ai
