# Optional Neon-backed API base URL for server-only features such as CEO profile access.
VITE_NEON_API_URL=

# Firebase Web App configuration (public client settings; restrict the API key in Google Cloud).
# Create these values in Firebase Console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Auth providers must also be enabled in Firebase Console.

# Server-side NVIDIA credentials for ENOSX AI chat and image generation.
# Never expose these keys with a VITE_ prefix.
NVIDIA_API_KEY=
NVIDIA_IMAGE_API_KEY=
# URL of your deployed Stable Diffusion 3.5 Large NIM service (for example, https://your-nim-host/v1/infer).
# The NVIDIA Build catalog currently lists this model as downloadable, not as a hosted inference endpoint.
# Set as server-only deployment variables; never add a VITE_ prefix.
NVIDIA_IMAGE_ENDPOINT=
NVIDIA_IMAGE_MODEL=stabilityai/stable-diffusion-3.5-large
PUBLIC_APP_URL=https://enosx.ai
# Automatic client error reports (server-side only; never use a VITE_ prefix).
# Use a Resend API key and a sender address/domain verified in Resend.
RESEND_API_KEY=
ERROR_REPORT_FROM=ENOSX AI <errors@enosx.ai>
