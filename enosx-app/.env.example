# Optional Neon-backed API base URL for server-only features such as CEO profile access.
VITE_NEON_API_URL=

# Firebase Web App configuration (public client settings; restrict the API key in Google Cloud).
# Create these values in Firebase Console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Auth providers must also be enabled in Firebase Console.

# Meta / Instagram OAuth and WhatsApp verification credentials.
# These are server-side values: do not add a VITE_ prefix or commit real values.
# Instagram OAuth requires an OAuth callback implementation and a registered redirect URI.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_OAUTH_REDIRECT_URI=
# WhatsApp Business Cloud API is not a standard "Sign in with WhatsApp" OAuth provider.
# These values are for a server-side WhatsApp OTP flow, if enabled.
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=

# Server-side NVIDIA credentials for ENOSX AI chat, image generation, and video generation.
# Never expose these keys with a VITE_ prefix.
NVIDIA_API_KEY=
# Tavily web and media search credential; server-side only, never use a VITE_ prefix.
TAVILY_API_KEY=
# Recommended text models: Muse Glimmer for Core/Pro, Nemotron 3 Ultra for ENOSH MIND.
NVIDIA_MODEL=meta/muse-glimmer-30b
NVIDIA_EX_CORE_MODEL=meta/muse-glimmer-30b
NVIDIA_EX_PRO_MODEL=meta/muse-glimmer-30b
NVIDIA_ENOSH_MIND_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_VISION_MODEL=meta/muse-glimmer-30b
NVIDIA_EX_CORE_VISION_MODEL=meta/muse-glimmer-30b
NVIDIA_EX_PRO_VISION_MODEL=meta/muse-glimmer-30b
NVIDIA_IMAGE_API_KEY=
# Optional custom image endpoint. Defaults to NVIDIA's hosted FLUX.2 Klein 4B API.
# Set provider keys only as server-side deployment variables; never add a VITE_ prefix.
NVIDIA_IMAGE_ENDPOINT=
NVIDIA_IMAGE_MODEL=black-forest-labs/flux.2-klein-4b
# Optional separate video key; falls back to NVIDIA_API_KEY.
NVIDIA_VIDEO_API_KEY=
PUBLIC_APP_URL=https://enosx.ai
# Automatic client error reports (server-side only; never use a VITE_ prefix).
# Use a Resend API key and a sender address/domain verified in Resend.
RESEND_API_KEY=
ERROR_REPORT_FROM=ENOSX AI <errors@enosx.ai>
