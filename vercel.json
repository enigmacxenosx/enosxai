{
  "version": 2,
  "outputDirectory": "enosx-app/dist/public",
  "buildCommand": "pnpm run build",
  "rewrites": [
    {
      "source": "/api/healthz",
      "destination": "/api/health"
    },
    {
      "source": "/api/speed-test",
      "destination": "/api/health"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
