{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "vite",
  "outputDirectory": "enosx-app/dist/public",
  "buildCommand": "pnpm run build",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/connectors/:connector/oauth/:phase",
      "destination": "/api/connectors/oauth?route=:connector/:phase"
    },
    {
      "source": "/api/browser/read",
      "destination": "/api/browser-routes?route=read"
    },
    {
      "source": "/api/browser/extract-links",
      "destination": "/api/browser-routes?route=extract-links"
    },
    {
      "source": "/api/healthz",
      "destination": "/api/browser-routes?route=healthz"
    },
    {
      "source": "/:path((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
