{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "vite",
  "outputDirectory": "enosx-app/dist/public",
  "installCommand": "corepack enable && corepack prepare pnpm@10.28.0 --activate && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/:path((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
